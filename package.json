{
  "name": "metroterm",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "serve": "npm run build && vite preview --host 0.0.0.0 --port 1420 --strictPort",
    "server": "cargo run --manifest-path src-rust/Cargo.toml --no-default-features --features server --bin metroterm-server --",
    "build:deb": "bash scripts/build-deb.sh",
    "build:deb:arm64": "bash scripts/build-deb.sh arm64",
    "build:windows": "bash scripts/build-windows.sh",
    "build:macos": "bash scripts/build-macos.sh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "format": "prettier --write src scripts index.html vite.config.ts tsconfig.json tsconfig.node.json",
    "format:check": "prettier --check src scripts index.html vite.config.ts tsconfig.json tsconfig.node.json",
    "check": "npm run typecheck && npm run format:check && cargo fmt --manifest-path src-rust/Cargo.toml --check",
    "verify:versions": "node scripts/versions.mjs verify",
    "sync:versions": "node scripts/versions.mjs sync",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "i18next": "^26.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetroTerm",
  "version": "0.0.1",
  "identifier": "dev.metroterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MetroTerm",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "create": false,
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "SimpChinese"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}